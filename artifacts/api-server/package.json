{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/development-runtime.mjs pnpm run dev:server",
    "dev:server": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:foundation": "tsx src/verification/foundation.ts",
    "verify:catalog": "tsx src/verification/landing-catalog.ts",
    "verify:exchange": "tsx src/verification/exchange.ts",
    "verify:customer": "tsx src/verification/customer.ts",
    "verify:master": "tsx src/verification/master-template.ts",
    "provision:master:dev": "tsx src/verification/provision-master-order.ts",
    "verify:authorization": "tsx src/verification/multi-tenant-security.ts",
    "samples:exchange:dev": "tsx src/verification/exchange-sample.ts",
    "samples:plans:dev": "tsx src/verification/sample-sites.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.18.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
