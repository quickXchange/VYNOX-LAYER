modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.build]
args = ["pnpm", "run", "release:check"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
QXLAYER_PLATFORM_HOSTS = "www.quicklychan.xyz,private-label-crypto-platform.replit.app"
QXLAYER_PLATFORM_URL = "https://www.quicklychan.xyz"

